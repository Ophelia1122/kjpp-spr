# Salin jadi file ".env" di folder proyek NAS, lalu isi nilai yang bertanda GANTI.

APP_NAME="KJPP SPR"
APP_ENV=production
# GANTI: salin persis APP_KEY dari .env laptop
APP_KEY=
APP_DEBUG=false
# GANTI: alamat IP NAS + port
APP_URL=http://192.168.1.100:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kjpp_db
DB_USERNAME=kjpp_user
# GANTI: password kuat (dipakai Laravel & container MySQL)
DB_PASSWORD=
# GANTI: password root MySQL (khusus container db)
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LIBREOFFICE_BIN=soffice
MAIL_MAILER=log
