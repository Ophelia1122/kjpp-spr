# Salin jadi file ".env" di folder proyek NAS, lalu isi nilai yang bertanda GANTI.

APP_NAME="KJPP SPR"
APP_ENV=production
# GANTI: salin persis APP_KEY dari .env laptop
APP_KEY=
APP_DEBUG=false
# GANTI: alamat utama aplikasi.
#  - Lewat Tailscale (docs/tutorial-deploy-nas-tailscale.md): https://kjpp-nas.nama-tailnet.ts.net
#  - Hanya jaringan kantor: http://192.168.1.100:8080
APP_URL=http://192.168.1.100:8080

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kjpp_db
DB_USERNAME=kjpp_user
# GANTI: password kuat (dipakai Laravel & container MySQL)
DB_PASSWORD=
# GANTI: password root MySQL (khusus container db)
DB_ROOT_PASSWORD=
# Zona waktu sesi database — WAJIB sama dengan laptop supaya jam tidak meleset
DB_TIMEZONE=+07:00

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LIBREOFFICE_BIN=soffice

# --- Bot notifikasi WhatsApp (docs/bot-whatsapp.md) ---
# GANTI: kunci acak panjang (dipakai container bot & aplikasi)
WA_BOT_API_KEY=
# GANTI: password database bot
WA_DB_PASSWORD=
WA_BOT_URL=http://kjpp-wa:8080
WA_BOT_INSTANCE=kjpp
# Aktifkan & pilih grup lewat menu Pengaturan Sistem > Bot WhatsApp
WA_BOT_ENABLED=false
MAIL_MAILER=log

# --- Tailscale sebagai container (Opsi 2, docs/tutorial-deploy-nas-tailscale.md) ---
# Nama perangkat NAS di tailnet (bagian depan alamat *.ts.net)
TS_HOSTNAME=kjpp-nas
# Isi auth key HANYA untuk login pertama, lalu kosongkan lagi
TS_AUTHKEY=
